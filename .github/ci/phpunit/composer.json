{
  "require"           : {
    "php" : ">=8.4"
  },
  "require-dev"       : {
    "valkyrja/ci-phpunit" : "^26.6.33"
  },
  "scripts"           : {
    "check"                  : "vendor/bin/phpunit --no-coverage --display-all-issues",
    "coverage"               : "php -d xdebug.mode=coverage -d memory_limit=-1 vendor/bin/phpunit --coverage-text --stderr",
    "path-coverage"          : "php -d xdebug.mode=coverage -d memory_limit=-1 vendor/bin/phpunit --path-coverage --coverage-text --stderr",
    "path-coverage-parallel" : "bash path-coverage-shards.sh",
    "path-coverage-shard"    : "bash path-coverage-shards.sh shard",
    "path-coverage-merge"    : "bash path-coverage-shards.sh merge"
  },
  "minimum-stability" : "dev",
  "prefer-stable"     : true
}
